    "native": "native build of ktock/qemu-wasm @0ef7b4e2 + patches 0001-0005, TCG host backend",
    "browser_stock": "pinned engine-20260907-0100: one WebAssembly.Module per block, 1500-execution compile threshold, 15000 live instances",
    "browser_merge": "experiments/wasm-batch-engine.patch, stage 1: per-block import tables relinked into 64-block modules; a block compiles after 32 interpreted runs; ~256k-block cache",
    "browser_chain": "stage 2: plus tail-call chaining between compiled blocks with rewind routing",
    "browser_final": "stage 3 (the patch as committed): plus guest registers in wasm locals, spilled only on an Asyncify unwind"
